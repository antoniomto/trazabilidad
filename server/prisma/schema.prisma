generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("OPERATOR")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  lotsCreated        Lot[]             @relation("LotCreator")
  lotsReleased       Lot[]             @relation("LotReleaser")
  phasesOperated     ProductionPhase[] @relation("PhaseOperator")
  phasesSupervsed    ProductionPhase[] @relation("PhaseSupervisor")
  paramsRecorded     PhaseParameter[]
  alertsAcknowledged Alert[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  phaseTemplates ProductPhaseTemplate[]
  lots           Lot[]
}

model ProductPhaseTemplate {
  id              String  @id @default(uuid())
  productId       String
  name            String
  orderIndex      Int
  expectedParams  String  @default("[]")
  hasQualityCheck Boolean @default(false)
  maxDurationMin  Int?

  product          Product           @relation(fields: [productId], references: [id])
  productionPhases ProductionPhase[]

  @@index([productId])
}

model RawMaterial {
  id       String  @id @default(uuid())
  name     String
  unit     String
  supplier String?
  active   Boolean @default(true)

  lotRawMaterials LotRawMaterial[]
}

model Lot {
  id           String    @id @default(uuid())
  lotNumber    String    @unique
  productId    String
  status       String    @default("OPEN")
  startDate    DateTime  @default(now())
  endDate      DateTime?
  batchSize    Float
  batchUnit    String
  notes        String?
  createdById  String
  releasedById String?
  releasedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product          Product           @relation(fields: [productId], references: [id])
  createdBy        User              @relation("LotCreator", fields: [createdById], references: [id])
  releasedBy       User?             @relation("LotReleaser", fields: [releasedById], references: [id])
  rawMaterials     LotRawMaterial[]
  productionPhases ProductionPhase[]
  alerts           Alert[]

  @@index([status])
  @@index([productId])
  @@index([createdAt])
}

model LotRawMaterial {
  id            String   @id @default(uuid())
  lotId         String
  rawMaterialId String
  quantity      Float
  unit          String
  supplierLot   String
  internalLot   String
  chlorineConc  Float?
  receivedAt    DateTime @default(now())
  notes         String?

  lot         Lot         @relation(fields: [lotId], references: [id])
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@index([lotId])
}

model ProductionPhase {
  id              String    @id @default(uuid())
  lotId           String
  templateId      String?
  name            String
  orderIndex      Int
  status          String    @default("PENDING")
  startedAt       DateTime?
  completedAt     DateTime?
  mermaKg         Float?
  qualityApproved Boolean?
  qualityNote     String?
  operatorId      String?
  supervisorId    String?
  notes           String?
  createdAt       DateTime  @default(now())

  lot        Lot                   @relation(fields: [lotId], references: [id])
  template   ProductPhaseTemplate? @relation(fields: [templateId], references: [id])
  operator   User?                 @relation("PhaseOperator", fields: [operatorId], references: [id])
  supervisor User?                 @relation("PhaseSupervisor", fields: [supervisorId], references: [id])
  parameters PhaseParameter[]
  alerts     Alert[]

  @@index([lotId])
  @@index([status])
}

model PhaseParameter {
  id           String   @id @default(uuid())
  phaseId      String
  key          String
  value        Float
  unit         String
  recordedAt   DateTime @default(now())
  recordedById String
  isOutOfRange Boolean  @default(false)
  notes        String?

  phase      ProductionPhase @relation(fields: [phaseId], references: [id])
  recordedBy User            @relation(fields: [recordedById], references: [id])
  alerts     Alert[]

  @@index([phaseId])
  @@index([isOutOfRange])
}

model Alert {
  id               String    @id @default(uuid())
  lotId            String
  phaseId          String?
  parameterId      String?
  type             String
  severity         String
  message          String
  status           String    @default("ACTIVE")
  acknowledgedById String?
  acknowledgedAt   DateTime?
  acknowledgeNote  String?
  createdAt        DateTime  @default(now())

  lot            Lot              @relation(fields: [lotId], references: [id])
  phase          ProductionPhase? @relation(fields: [phaseId], references: [id])
  parameter      PhaseParameter?  @relation(fields: [parameterId], references: [id])
  acknowledgedBy User?            @relation(fields: [acknowledgedById], references: [id])

  @@index([status])
  @@index([lotId])
}
