# Copia este archivo como server/.env y llena los valores
# NUNCA subas server/.env a git

# Base de datos SQLite (archivo local, no necesita servidor)
DATABASE_URL="file:/root/trazabilidad/server/data/prod.db"

# JWT — genera strings aleatorios largos (mínimo 32 caracteres)
# Usa: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="cambia-esto-por-un-string-aleatorio-seguro-min-32-chars"
JWT_REFRESH_SECRET="otro-string-aleatorio-diferente-min-32-chars-aqui"

# Servidor
PORT=3001
NODE_ENV=production

# Zona horaria de la planta
PLANT_TIMEZONE="America/Mexico_City"

# CORS — pon aquí tu IP o dominio SIN barra final
ALLOWED_ORIGIN="http://TU_IP_DEL_VPS"
