# ─── Copia este archivo como .env.production y llena los valores ───────────────
# NUNCA subas .env.production a git

# Base de datos
# "postgres" es el nombre del servicio en docker-compose.yml
DATABASE_URL="postgresql://postgres:TU_PASSWORD_SEGURO@postgres:5432/trazabilidad"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_PASSWORD_SEGURO
POSTGRES_DB=trazabilidad

# JWT — genera strings aleatorios largos (mínimo 32 caracteres)
# Puedes usar: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-string-aleatorio-seguro-min-32-chars"
JWT_REFRESH_SECRET="otro-string-aleatorio-diferente-min-32-chars-aqui"

# Servidor
PORT=3001
NODE_ENV=production

# Zona horaria de la planta
PLANT_TIMEZONE="America/Mexico_City"

# CORS — pon aquí tu IP o dominio SIN barra final
# Ejemplos:
#   ALLOWED_ORIGIN="http://192.168.1.100"
#   ALLOWED_ORIGIN="https://trazabilidad.miplanta.com"
ALLOWED_ORIGIN="http://TU_IP_O_DOMINIO"
